# Copy this file to .env and fill in your own values. Never commit .env.
#
# The app looks for .env in two places and uses the first one it finds:
#   1. this repo's folder        (<repo>/.env)
#   2. the folder above the repo (<repo>/../.env)
# Variables already set in your shell override the file.

# --- Required for the AI features (matching recommendations, case summaries) ---
# Portkey API key. Without it, everything else still works and the AI buttons say AI is not configured.
PORTKEY_API_KEY=

# --- Optional (defaults shown) ---
# Review mode: 1 = one-click demo sign-in with no password check; 0 = passwords required.
FOSTERMATCH_DEMO_SIGNIN=1
# Password mode only: password for the first 'admin' account. If blank, a one-time password is printed at first start.
FOSTERMATCH_ADMIN_PASSWORD=
# Set to 1 when the app is served over HTTPS (marks the session cookie Secure).
FOSTERMATCH_SECURE_COOKIES=0
# SQLite database file. Default: data/fostermatch.db in the repo.
FOSTERMATCH_DB=
# 1 = fill an empty database with the fictional demo caseload; 0 = start empty.
FOSTERMATCH_SEED=1
# AI cost guards: concurrent AI runs, and AI runs per minute.
FOSTERMATCH_AI_CONCURRENCY=3
FOSTERMATCH_AI_PER_MINUTE=20
